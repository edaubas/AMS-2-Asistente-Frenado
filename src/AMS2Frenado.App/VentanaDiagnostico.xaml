<Window x:Class="AMS2Frenado.App.VentanaDiagnostico"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMS2 Asistente de Frenado - Diagnostico" Width="820" Height="560"
        Closed="AlCerrar">
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BotonCaptura" Content="Empezar captura cruda" Padding="12,4" Click="AlPulsarCaptura"/>
            <TextBlock x:Name="TextoCaptura" Margin="12,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="TextoEstado" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
        <TextBox x:Name="TextoDump" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
</Window>
