<Window x:Class="AMS2Frenado.App.VentanaOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMS2 Asistente de Frenado - Overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        MouseLeftButtonDown="AlPulsarMouse" MouseWheel="AlRueda">
    <Grid x:Name="Raiz" Width="320" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Escala" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <StackPanel>
            <!-- ventana desbloqueada: chip + como volver (UI-SPEC pantalla 12) -->
            <Border x:Name="PanelDesbloqueo" Visibility="Collapsed" Background="#0C0E11" CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                <StackPanel>
                    <Border Background="#17304D" CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                        <TextBlock Text="DESBLOQUEADO · arrastrá para mover" FontFamily="{StaticResource Inter}" FontSize="11" FontWeight="SemiBold" Foreground="#8CC3FF"/>
                    </Border>
                    <TextBlock x:Name="TxtComoBloquear" Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="{StaticResource Inter}" FontSize="12" Foreground="#A9B2BC"/>
                </StackPanel>
            </Border>

            <!-- tarjeta de guia / lejos / sin datos / grabando -->
            <Border x:Name="Tarjeta" CornerRadius="10" Margin="0,0,0,8" Visibility="Collapsed">
                <StackPanel>
                    <Border x:Name="Franja" Height="40" CornerRadius="9,9,0,0" Visibility="Collapsed">
                        <Grid Margin="14,0">
                            <TextBlock x:Name="TxtFranja" VerticalAlignment="Center" FontFamily="{StaticResource Barlow}" FontWeight="Bold" FontSize="30"/>
                            <TextBlock x:Name="TxtFranjaCurva" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="{StaticResource Barlow}" FontWeight="Bold" FontSize="22"/>
                        </Grid>
                    </Border>
                    <StackPanel x:Name="Cuerpo" Margin="14,12,14,14">
                        <!-- Aproximacion / Inminente: encabezado -->
                        <Grid x:Name="FilaEncabezado" Margin="0,0,0,4">
                            <TextBlock x:Name="TxtCurva" FontFamily="{StaticResource Barlow}" FontWeight="Bold" FontSize="22" Foreground="#EEF1F4"/>
                            <TextBlock x:Name="TxtVelocidades" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="{StaticResource Inter}" FontSize="12" Foreground="#A9B2BC"/>
                        </Grid>
                        <!-- leyenda de referencias: rombo IA / circulo VOS (siempre, tambien en la frenada) -->
                        <StackPanel x:Name="PanelEtiquetas" Orientation="Horizontal" Height="16" Margin="0,0,0,2"/>
                        <!-- velocidad minima de TOQUE / LEVANTA (la frenada ya no lleva cartel grande) -->
                        <Grid x:Name="FilaNumero">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtNumero" FontFamily="{StaticResource Barlow}" FontWeight="Bold" FontSize="64" Foreground="#FFFFFF" TextAlignment="Left" LineStackingStrategy="BlockLineHeight" LineHeight="61"/>
                                    <TextBlock x:Name="TxtUnidad" FontFamily="{StaticResource Barlow}" FontWeight="SemiBold" FontSize="30" Foreground="#A9B2BC" VerticalAlignment="Bottom" Margin="6,0,0,8"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="Secundario" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                                <StackPanel x:Name="PanelEtiquetaSec" Orientation="Horizontal" HorizontalAlignment="Right" Height="16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtNumeroSec" FontFamily="{StaticResource Barlow}" FontWeight="SemiBold" FontSize="30" Foreground="#DDE2E7"/>
                                    <TextBlock x:Name="TxtUnidadSec" FontFamily="{StaticResource Barlow}" FontWeight="SemiBold" FontSize="30" Foreground="#DDE2E7" Margin="5,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <!-- barra de progreso (regla de 18 px) con los marcadores de IA y vos -->
                        <Canvas x:Name="CanvasRegla" Height="32" Margin="0,8,0,0"/>
                        <TextBlock x:Name="TxtMetros" Margin="0,2,0,0" FontFamily="{StaticResource Barlow}" FontWeight="SemiBold" FontSize="14" Foreground="#DDE2E7"/>

                        <!-- Lejos: una linea -->
                        <Grid x:Name="FilaLejos">
                            <TextBlock x:Name="TxtLejosEtiqueta" VerticalAlignment="Center" FontFamily="{StaticResource Inter}" FontSize="12" Foreground="#A9B2BC"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtLejosCurva" FontFamily="{StaticResource Barlow}" FontWeight="SemiBold" FontSize="22" Foreground="#EEF1F4"/>
                                <TextBlock x:Name="TxtLejosMetros" FontFamily="{StaticResource Barlow}" FontWeight="Medium" FontSize="22" Foreground="#A9B2BC"/>
                            </StackPanel>
                        </Grid>

                        <!-- SIN DATOS / avisos -->
                        <StackPanel x:Name="PanelAviso">
                            <TextBlock x:Name="TxtTitulo" FontFamily="{StaticResource Barlow}" FontWeight="Bold" FontSize="30" Foreground="#C3CAD1"/>
                            <TextBlock x:Name="TxtLinea1" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="{StaticResource Inter}" FontSize="13" Foreground="#DDE2E7"/>
                            <TextBlock x:Name="TxtLinea2" Margin="0,6,0,0" TextWrapping="Wrap" FontFamily="{StaticResource Inter}" FontSize="13" Foreground="#A9B2BC"/>
                        </StackPanel>

                        <!-- GRABANDO: contadores -->
                        <StackPanel x:Name="PanelContadores">
                            <TextBlock x:Name="TxtEncabContadores" FontFamily="{StaticResource Inter}" FontSize="12" Foreground="#A9B2BC"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="ColContIa" Grid.Column="0">
                                    <StackPanel x:Name="EtiquetaContIa" Orientation="Horizontal"/>
                                    <TextBlock x:Name="TxtContIa" FontFamily="{StaticResource Barlow}" FontWeight="SemiBold" FontSize="26" Foreground="#EEF1F4"/>
                                    <TextBlock x:Name="TxtContIaDet" TextWrapping="Wrap" FontFamily="{StaticResource Inter}" FontSize="12" Foreground="#A9B2BC"/>
                                </StackPanel>
                                <StackPanel x:Name="ColContVos" Grid.Column="1">
                                    <StackPanel x:Name="EtiquetaContVos" Orientation="Horizontal"/>
                                    <TextBlock x:Name="TxtContVos" FontFamily="{StaticResource Barlow}" FontWeight="SemiBold" FontSize="26" Foreground="#EEF1F4"/>
                                    <TextBlock x:Name="TxtContVosDet" TextWrapping="Wrap" FontFamily="{StaticResource Inter}" FontSize="12" Foreground="#A9B2BC"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="TxtPieContadores" Margin="0,10,0,0" TextWrapping="Wrap" FontFamily="{StaticResource Inter}" FontSize="12" Foreground="#A9B2BC"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- cabecera: pista, chip de la clase, chip de modo y avisos (el mini mapa ya no existe) -->
            <Border x:Name="TarjetaCabecera" CornerRadius="10" Padding="12,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtTituloPista" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                                   FontFamily="{StaticResource Inter}" FontSize="12" Foreground="#A9B2BC" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border x:Name="ChipClase" Background="#2A3139" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                <TextBlock x:Name="TxtChipClase" FontFamily="{StaticResource Inter}" FontSize="11" FontWeight="SemiBold" Foreground="#EEF1F4"/>
                            </Border>
                            <Border x:Name="ChipModo" CornerRadius="4" Padding="6,2">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="PuntoChipModo" Width="7" Height="7" Fill="#FF5A4E" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtChipModo" FontFamily="{StaticResource Inter}" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="TxtAviso" Margin="0,6,0,0" Visibility="Collapsed" TextWrapping="Wrap" FontFamily="{StaticResource Inter}" FontSize="12" Foreground="#FF9C94"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- contorno discontinuo azul mientras esta desbloqueada -->
        <Rectangle x:Name="Contorno" Visibility="Collapsed" IsHitTestVisible="False" RadiusX="12" RadiusY="12"
                   Stroke="#5AA9FF" StrokeThickness="2" StrokeDashArray="3 3" Margin="-1"/>
        <!-- agarre para cambiar el tamano (solo desbloqueada) -->
        <Thumb x:Name="Agarre" Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed"
               Cursor="SizeNWSE" DragDelta="AlArrastrarAgarre" DragCompleted="AlSoltarAgarre">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Polygon Points="18,0 18,18 0,18" Fill="#5AA9FF"/>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
